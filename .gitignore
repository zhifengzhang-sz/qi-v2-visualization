# the TypeScript's packages (what the targets write, the charts, the engines' scripts and the reports, is in .reports/,
# the kit's below)
node_modules/
# a local cache no target writes now (an earlier version's fetched results): never committed
/.cache/
# what LaTeX writes while it builds the static picture
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
# direnv: nix-direnv's cache, and each author's own choice of shell
.direnv/
.envrc.local
# a session's own settings for this machine: never published
.claude/settings.local.json
# the owner's local file
todo.md
# the kit's: its link, the files make agents generates, a developer's own choices, a role's run in progress
/dev/agents
/AGENTS.md
/CLAUDE.md
/.claude/agents/
/.claude/workflows/
/.github/agents/
/.github/hooks/kit.json
/agents.generated
/agents.local.json
/agents.run/
/.reports/
