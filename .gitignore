# the TypeScript's packages and what the targets write (the charts, the engines' scripts, the reports)
node_modules/
.reports/
# a local cache no target writes now (an earlier version's fetched results): never committed
/.cache/
# what LaTeX writes while it builds the static picture
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
# direnv: nix-direnv's cache, and each author's own choice of shell
.direnv/
.envrc.local
# a session's own settings for this machine: never published
.claude/settings.local.json
# the owner's local file
todo.md
# the kit, linked by make install, and what it writes from agents/ (make agents): built output, never edited
/dev/agents
/agents.generated
/agents.local.json
/agents.run/
/AGENTS.md
/CLAUDE.md
/.claude/agents/
/.claude/workflows/
/.github/agents/
/.github/hooks/kit.json
